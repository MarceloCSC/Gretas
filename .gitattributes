# ============================================================
# Unity - Standard .gitattributes
# Text normalization, binary assets, whitespace and Linguist
# ============================================================

# ------------------------------------------------------------
# Default text normalization
# ------------------------------------------------------------

* text=auto

# ------------------------------------------------------------
# Source code and configuration
# ------------------------------------------------------------

*.cs text
*.json text
*.asmdef text
*.asmref text
*.shader text
*.compute text
*.cginc text
*.hlsl text
*.inputactions text

# ------------------------------------------------------------
# Unity serialized assets
# ------------------------------------------------------------

*.meta text
*.unity text
*.prefab text
*.asset text=auto
*.anim text
*.controller text
*.mat text
*.physicMaterial text
*.physicsMaterial2D text
*.renderTexture text=auto
*.scenetemplate text=auto

# ------------------------------------------------------------
# Binary assets
# ------------------------------------------------------------

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.psd binary
*.tga binary
*.tif binary
*.tiff binary
*.exr binary
*.hdr binary

*.fbx binary
*.blend binary

*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary
*.mov binary

*.ttf binary
*.otf binary

*.dll binary
*.unitypackage binary

# ------------------------------------------------------------
# Unity-generated YAML whitespace
# ------------------------------------------------------------

*.asset whitespace=-blank-at-eol
*.unity whitespace=-blank-at-eol
*.prefab whitespace=-blank-at-eol
*.meta whitespace=-blank-at-eol
*.anim whitespace=-blank-at-eol
*.controller whitespace=-blank-at-eol
*.mat whitespace=-blank-at-eol
*.physicMaterial whitespace=-blank-at-eol
*.physicsMaterial2D whitespace=-blank-at-eol
*.renderTexture whitespace=-blank-at-eol
*.scenetemplate whitespace=-blank-at-eol

# ------------------------------------------------------------
# Third-party assets - TextMesh Pro
# ------------------------------------------------------------

"Assets/TextMesh Pro/Shaders/**" whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
"Assets/TextMesh Pro/**" linguist-vendored
