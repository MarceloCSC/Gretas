# ============================================================
# Unity - Standard .gitignore
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore
# ============================================================

# ------------------------------------------------------------
# Unity-generated directories
# ------------------------------------------------------------

.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# ------------------------------------------------------------
# Logs and diagnostic files
# ------------------------------------------------------------

*.log
mono_crash.*
sysinfo.txt

# ------------------------------------------------------------
# Blender backup files
# ------------------------------------------------------------

*.blend1
*.blend1.meta

# ------------------------------------------------------------
# Memory captures and recordings
# ------------------------------------------------------------

/[Mm]emoryCaptures/
/[Rr]ecordings/

# ------------------------------------------------------------
# IDEs and development tools
# ------------------------------------------------------------

.vs/
.idea/
.gradle/
ExportedObj/
.consulo/

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# ------------------------------------------------------------
# Autogenerated solution and project files
# ------------------------------------------------------------

*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Generated metadata
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ------------------------------------------------------------
# Builds and exported packages
# ------------------------------------------------------------

*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics
crashlytics-build.properties

# ------------------------------------------------------------
# Unity Test Runner
# ------------------------------------------------------------

InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# ------------------------------------------------------------
# Unity Addressables generated files
# ------------------------------------------------------------

/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# ------------------------------------------------------------
# Unity Visual Scripting generated files
# ------------------------------------------------------------

/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# ------------------------------------------------------------
# Unity UI Toolkit generated files
# ------------------------------------------------------------

/UIElementsSchema/

# ------------------------------------------------------------
# Unity scene dependency cache
# ------------------------------------------------------------

/[Aa]ssets/[Ss]ceneDependencyCache*

# ------------------------------------------------------------
# Legacy Unity Version Control (Plastic SCM / Collaborate)
# ------------------------------------------------------------

/.plastic/
/ignore.conf
/.collabignore

# ------------------------------------------------------------
# Operating system files
# ------------------------------------------------------------

.DS_Store
Thumbs.db
Desktop.ini
